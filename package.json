{
  "name": "wdatabase-vscode",
  "displayName": "WDatabase Tools",
  "description": "Intelligent control suite & visual tools for the wisrovi database ecosystem (wpostgresql, wredis, wsqlite, wclickhouse, wmongo, wtinydb, wmysql, wmariadb, wElasticsearch, wdatabricks, wSnowflake)",
  "version": "1.4.0",
  "publisher": "wisrovi",
  "author": {
    "name": "William Rodriguez (wisrovi)",
    "email": "wisrovi.rodriguez@gmail.com",
    "url": "https://github.com/wisrovi"
  },
  "homepage": "https://github.com/wisrovi/wdatabase-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/wisrovi/wdatabase-vscode.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onView:wdatabaseExplorer"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.11.9",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "wdatabase.refreshExplorer",
        "title": "WDatabase: Refresh Workspace Scanner",
        "icon": "$(refresh)"
      },
      {
        "command": "wdatabase.previewERD",
        "title": "WDatabase: Preview DB Entity-Relationship Diagram (ERD)",
        "icon": "$(graph)"
      },
      {
        "command": "wdatabase.openDashboard",
        "title": "WDatabase: Open Control Center & Data Inspector",
        "icon": "$(dashboard)"
      },
      {
        "command": "wdatabase.showCheatSheet",
        "title": "WDatabase: Show Architect Patterns CheatSheet",
        "icon": "$(book)"
      },
      {
        "command": "wdatabase.createModelWizard",
        "title": "WDatabase: Launch Model Generator Wizard",
        "icon": "$(add)"
      },
      {
        "command": "wdatabase.createConnectionWizard",
        "title": "WDatabase: Launch Connection Config Wizard",
        "icon": "$(plug)"
      },
      {
        "command": "wdatabase.openQueryPlayground",
        "title": "WDatabase: Open Query & NoSQL Playground",
        "icon": "$(terminal)"
      },
      {
        "command": "wdatabase.generateMigration",
        "title": "WDatabase: Generate Schema Migration Script",
        "icon": "$(diff)"
      },
      {
        "command": "wdatabase.generateTestSuite",
        "title": "WDatabase: Generate Pytest Integration Suite",
        "icon": "$(beaker)"
      },
      {
        "command": "wdatabase.generateWPipeStep",
        "title": "WDatabase: Generate WPipe Pipeline Step (@step)",
        "icon": "$(rocket)"
      },
      {
        "command": "wdatabase.generateMockData",
        "title": "WDatabase: Generate Synthetic Mock / Seed Data Script",
        "icon": "$(sparkle)"
      },
      {
        "command": "wdatabase.runModelTests",
        "title": "WDatabase: Run Pytest Suite for Model",
        "icon": "$(play)"
      },
      {
        "command": "wdatabase.reverseEngineerDB",
        "title": "WDatabase: Reverse Engineer Existing DB to Pydantic Models",
        "icon": "$(sync)"
      },
      {
        "command": "wdatabase.manageContainer",
        "title": "WDatabase: Spin Up Local Dev Database Container (Docker)",
        "icon": "$(server)"
      },
      {
        "command": "wdatabase.testConnection",
        "title": "WDatabase: Test Database Connectivity",
        "icon": "$(check)"
      },
      {
        "command": "wdatabase.addVaultSecret",
        "title": "WDatabase: Add New Secret to WAuth Vault",
        "icon": "$(lock)"
      },
      {
        "command": "wdatabase.detectSchemaDrift",
        "title": "WDatabase: Detect Live Schema Drift vs Pydantic Model",
        "icon": "$(search-fuzzy)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wdatabase-sidebar",
          "title": "WDatabase Tools",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "wdatabase-sidebar": [
        {
          "id": "wdatabaseExplorer",
          "name": "Bound DB Models & Engines",
          "icon": "icon.png"
        },
        {
          "id": "wdatabaseVault",
          "name": "WAuth Secret Vault (AES-256)",
          "icon": "icon.png"
        }
      ]
    },
    "configuration": {
      "title": "WDatabase Tools",
      "properties": {
        "wdatabase.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/venv/**"
          ],
          "description": "Glob patterns to exclude when scanning Python files for Pydantic DB models."
        },
        "wdatabase.enableForensicBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show forensic audit badges (status=99 soft-delete) on models inheriting from ForensicModel."
        }
      }
    }
  }
}
